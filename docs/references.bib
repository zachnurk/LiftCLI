}

@article{knowles2018,
  author  = {Knowles, Olivia E. and Drinkwater, Eric J. and Urwin, Charles S.
             and Lamon, S{\'e}verine and Aisbett, Brad},
  title   = {Inadequate Sleep and Muscle Strength: Implications for Resistance
             Training},
  journal = {Journal of Science and Medicine in Sport},
  year    = {2018},
  volume  = {21},
  number  = {9},
  pages   = {959--968},
  doi     = {10.1016/j.jsams.2018.01.012},
  note    = {Used by hold\_on\_short\_sleep. One night of sleep loss had little
