  journal = {Medicine \& Science in Sports \& Exercise},
  year    = {2009},
  volume  = {41},
  number  = {3},
  pages   = {687--708},
  doi     = {10.1249/MSS.0b013e3181915670},
  note    = {Used by step\_up\_after\_go\_up\_reps: add 2-10\% load once the
